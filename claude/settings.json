{
  "permissions": {
    "allow": ["Bash"],
    "deny": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(pip install:*)",
      "Bash(pip3 install:*)",
      "Bash(brew install:*)",
      "Bash(yarn add:*)",
      "Bash(yarn install:*)",
      "Bash(go install:*)"
    ],
    "ask": ["Bash(git rebase:*)"]
  },
  "model": "opus[1m]",
  "enabledPlugins": {
    "figma@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true
  },
  "sandbox": {
    "excludedCommands": ["gh *"]
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "theme": "dark",
  "skipAutoPermissionPrompt": true
}
